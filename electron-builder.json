{
  "appId": "local.interview.knowledgecards",
  "productName": "面试知识卡",
  "directories": { "output": "releases", "buildResources": "dist", "app": ".cache/desktop-package" },
  "files": ["main.cjs", "package.json", "!node_modules/**"],
  "extraResources": [{ "from": "dist", "to": "dist", "filter": ["**/*", "!.vite/**"] }, { "from": "migrations", "to": "migrations", "filter": ["*.sql"] }],
  "asar": true,
  "publish": [{ "provider": "github", "owner": "Wahuwahuuu", "repo": "interview-knowledge-cards", "releaseType": "release" }],
  "electronUpdaterCompatibility": ">=2.16",
  "npmRebuild": false,
  "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false },
  "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "artifactName": "Interview-Knowledge-Cards-${version}-Setup.${ext}", "shortcutName": "面试知识卡", "runAfterFinish": false },
  "portable": { "artifactName": "Interview-Knowledge-Cards-${version}-Portable.${ext}" }
}
