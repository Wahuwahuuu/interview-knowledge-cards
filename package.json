{
  "name": "interview-knowledge-cards",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1 --port 8787",
    "preview:groups": "node scripts/preview-groups.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:api": "node scripts/verify-api.mjs",
    "deploy": "node scripts/deploy.mjs",
    "setup": "node scripts/init-config.mjs",
    "test:accounts": "node scripts/verify-accounts.mjs",
    "seed:demo": "node scripts/seed-local.mjs",
    "desktop:compile": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run build && npm run desktop:compile && electron .",
    "desktop:server": "node desktop-dist/cli.cjs",
    "desktop:package": "npm run build && npm run desktop:compile && electron-builder --config electron-builder.json --win nsis portable --publish never",
    "test:sync": "vitest run tests/sync.test.ts tests/desktop-sync.test.ts tests/replica.test.ts tests/cloud-sync.test.ts tests/incremental-sync.test.ts tests/card-edit.test.ts tests/record-operations.test.ts",
    "desktop:migrate": "node scripts/migrate-to-desktop.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "^2.2.0",
    "d3-force": "^3.0.0",
    "electron-updater": "6.8.9",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "undici": "7.29.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.45.0"
  },
  "license": "MIT",
  "description": "面试知识卡：项目题库、翻卡复习、知识图谱、独立账户与 AI 导入",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wahuwahuuu/interview-knowledge-cards.git"
  },
  "main": "desktop-dist/main.cjs"
}
