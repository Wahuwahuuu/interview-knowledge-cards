{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interview-knowledge-cards",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./dist","binding":"ASSETS","run_worker_first":true,"not_found_handling":"single-page-application"},
  "vars": {
    "APP_ENV":"production",
    "OWNER_EMAIL":"admin@example.com",
    "ACCESS_TEAM_DOMAIN":"",
    "ACCESS_AUD":"",
    "AGENT_ACCESS_AUD":""
  },
  "d1_databases": [{"binding":"DB","database_name":"interview-knowledge-cards","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}
